# Optional executable overrides. The defaults resolve these names from PATH.
REDACT_VIDEO_FFMPEG=ffmpeg
REDACT_VIDEO_FFPROBE=ffprobe

# Prevent PaddleX from probing remote model hosts during startup. Model weights
# may still be downloaded on first use unless local model directories are set.
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Optional Phase 8 API settings. The service binds to loopback by default.
REDACT_VIDEO_API_HOST=127.0.0.1
REDACT_VIDEO_API_PORT=8000
REDACT_VIDEO_API_WORKERS=1
REDACT_VIDEO_API_QUEUE_SIZE=4
REDACT_VIDEO_API_MAX_UPLOAD_BYTES=2147483648
REDACT_VIDEO_API_RETENTION_SECONDS=3600
# REDACT_VIDEO_API_JOB_ROOT=/tmp/video-redactor
# REDACT_VIDEO_CONFIG=/absolute/path/to/config.yaml
